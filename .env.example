# ============================================================
# GainOS Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# ---- Supabase (get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Anthropic (get from https://console.anthropic.com) ----
OPENAI_API_KEY=sk-ant-...

# ---- Mobile (Expo) — prefix EXPO_PUBLIC_ to expose to client ----
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Web (Next.js) — prefix NEXT_PUBLIC_ to expose to client ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
