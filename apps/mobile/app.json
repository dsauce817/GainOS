{
  "expo": {
    "name": "GainOS",
    "slug": "gainos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gainos.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "GainOS uses your photo library for progress photos.",
        "NSCameraUsageDescription": "GainOS uses your camera for progress photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.gainos.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366f1"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GainOS accesses your photos to save progress pictures."
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "scheme": "gainos",
    "experiments": {
      "typedRoutes": true
    }
  }
}
